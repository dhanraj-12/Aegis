# Stage 1: Build the Dummy Backend
FROM golang:1.24-alpine AS builder
WORKDIR /src
COPY test/backend/main.go ./
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/dummy_backend main.go

# Stage 2: Distroless runtime
FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /
COPY --from=builder /bin/dummy_backend /dummy_backend
EXPOSE 5000
USER nonroot:nonroot
ENTRYPOINT ["/dummy_backend"]
CMD ["-port", "5000"]
